<!DOCTYPE html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>A-Frame Keyboard Interaction</title>
    <script src="https://aframe.io/releases/1.4.1/aframe.min.js"></script>
  </head>

  <body>
    <a-scene background="color: #ECECEC">
      <!-- Kamera -->
      <a-entity camera look-controls wasd-controls position="0 1.6 4"></a-entity>

      <!-- Lantai -->
      <a-plane rotation="-90 0 0" width="20" height="20" color="#7BC8A4"></a-plane>

      <!-- Satu objek utama -->
      <a-box id="mainBox" position="0 1 -3" color="#4CC3D9" rotation="0 0 0"></a-box>

      <script>
        document.addEventListener("DOMContentLoaded", () => {
          const box = document.querySelector("#mainBox");
          let isRotating = false;
          let rotation = box.getAttribute("rotation");

          // Event keyboard
          document.addEventListener("keydown", (e) => {
            if (e.key === "r" || e.key === "R") {
              // Ganti warna acak
              const newColor = "#" + Math.floor(Math.random() * 16777215).toString(16);
              box.setAttribute("color", newColor);
            }

            if (e.key === "g" || e.key === "G") {
              // Toggle rotasi
              isRotating = !isRotating;
            }
          });

          // Animasi rotasi (loop)
          function animate() {
            if (isRotating) {
              rotation.y += 1; // tambah derajat tiap frame
              box.setAttribute("rotation", rotation);
            }
            requestAnimationFrame(animate);
          }

          animate(); // mulai animasi
        });
      </script>
    </a-scene>
  </body>
</html>
